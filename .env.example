# ─────────── Servidor ───────────
PORT=3300
# URL pública do backend depois do deploy (usada pra montar a URL do webhook)
PUBLIC_URL=https://bahiana-conta.onrender.com

# Senha do painel admin (você usa pra ver leads e pedidos)
ADMIN_PASSWORD=troque-esta-senha

# Segredo do token de sessão do cliente — gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-segredo

# ─────────── Banco (Postgres) ───────────
# Crie um grátis no Neon (https://neon.tech) e cole a connection string aqui.
# Local: pode subir um Postgres com Docker e usar postgres://postgres:postgres@localhost:5432/bahiana
DATABASE_URL=

# ─────────── Cakto (pagamento) ───────────
# Painel Cakto → Integrações → Cakto API → Criar Chave de API
# Escopos necessários: read, write, products, offers, orders, payments, webhooks
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# Preenchido pelo `npm run setup-cakto` (id do produto "Pedido Bahianá")
CAKTO_PRODUCT_ID=
# Gerado quando o webhook é criado (o setup-cakto mostra). Trate como senha.
CAKTO_WEBHOOK_SECRET=

# ─────────── Aviso de pedido pago ───────────
# WhatsApp da loja em formato E.164 (só dígitos): 55 + DDD + número
LOJA_WHATSAPP=5541984046124
# Fase 3: URL do bot pra ele mandar a mensagem sozinho. Deixe em branco por ora.
BOT_NOTIFY_URL=
BOT_NOTIFY_TOKEN=
